{
  "version": 1,
  "title": "Plan a Three-Stop Walking Route in Google Maps",
  "language": "en",
  "fidelity": "actual-source",
  "startUrl": "https://www.google.com/maps/search/Colosseum,+Rome/?hl=en&gl=us",
  "allowedOrigins": [
    "https://www.google.com"
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "key": "start",
      "title": "Start at the Colosseum",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Directions"
          }
        }
      ],
      "ready": {
        "role": "button",
        "name": "Reverse starting point and destination"
      },
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Reverse starting point and destination"
          },
          "text": "We opened the Colosseum and chose Directions. Click the swap button to make it the starting point.",
          "trigger": "goto",
          "goto": "walking",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Start at the Colosseum"
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "walking",
      "title": "Choose walking directions",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Reverse starting point and destination"
          }
        }
      ],
      "ready": "[role=\"radio\"][data-tooltip=\"Walking\"]",
      "annotations": [
        {
          "target": "[role=\"radio\"][data-tooltip=\"Walking\"]",
          "text": "Choose Walking for directions through central Rome.",
          "trigger": "goto",
          "goto": "pantheon",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Explore on foot"
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "pantheon",
      "title": "Set your first destination",
      "actions": [
        {
          "type": "click",
          "target": "[role=\"radio\"][data-tooltip=\"Walking\"]"
        }
      ],
      "ready": {
        "role": "textbox",
        "name": "Choose destination, or click on the map..."
      },
      "annotations": [
        {
          "target": {
            "role": "textbox",
            "name": "Choose destination, or click on the map..."
          },
          "text": "Enter Pantheon, Rome in the destination field and select the landmark. Click the highlighted field to see the result.",
          "trigger": "goto",
          "goto": "add-stop",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Visit the Pantheon"
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "add-stop",
      "title": "Add another stop",
      "actions": [
        {
          "type": "fill",
          "target": {
            "role": "textbox",
            "name": "Choose destination, or click on the map..."
          },
          "value": "Pantheon, Rome"
        },
        {
          "type": "press",
          "target": {
            "role": "textbox",
            "name": "Destination Pantheon, Rome"
          },
          "key": "Enter"
        }
      ],
      "ready": {
        "role": "button",
        "name": "Add destination"
      },
      "assertions": [
        {
          "target": "[role=\"main\"]",
          "containsText": "Details"
        }
      ],
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Add destination"
          },
          "text": "The first leg is ready. Click Add destination to include a third place in the same route.",
          "trigger": "goto",
          "goto": "trevi",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Add another stop"
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "trevi",
      "title": "Include Trevi Fountain",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Add destination"
          }
        }
      ],
      "ready": {
        "role": "textbox",
        "name": "Choose destination, or click on the map..."
      },
      "annotations": [
        {
          "target": {
            "role": "textbox",
            "name": "Choose destination, or click on the map..."
          },
          "text": "Enter Trevi Fountain, Rome in the new field and select the landmark. Click here to see the result.",
          "trigger": "goto",
          "goto": "review",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Add Trevi Fountain"
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "review",
      "title": "Review the complete route",
      "actions": [
        {
          "type": "fill",
          "target": {
            "role": "textbox",
            "name": "Choose destination, or click on the map..."
          },
          "value": "Trevi Fountain, Rome"
        },
        {
          "type": "press",
          "target": {
            "role": "textbox",
            "name": "Destination Trevi Fountain, Rome"
          },
          "key": "Enter"
        }
      ],
      "ready": {
        "role": "button",
        "name": "Add destination"
      },
      "assertions": [
        {
          "target": "[role=\"main\"]",
          "containsText": "Details"
        }
      ],
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Details"
          },
          "text": "The route connects all three landmarks. Choose Details to inspect the walking instructions.",
          "trigger": "goto",
          "goto": "details",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Review your walk"
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "details",
      "title": "Check before you set off",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Details"
          }
        }
      ],
      "ready": {
        "role": "button",
        "name": "Share directions"
      },
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Share directions"
          },
          "text": "Use Share directions in Google Maps to share your walk. Check current routes before leaving; this demo is not live navigation.",
          "trigger": "auto",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true,
          "label": "Your route is ready"
        }
      ],
      "settleMs": 3500
    }
  ]
}
