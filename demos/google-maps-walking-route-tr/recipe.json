        {
          "target": {
            "role": "textbox",
            "name": "Varış noktası seçin veya haritayı tıklayın..."
          },
          "label": "Trevi Çeşmesi’ni ekleyin",
          "text": "Yeni varış alanına Trevi Fountain, Rome yazın ve yeri seçin. İşaretli alana tıklayarak sonucu görebilirsiniz.",
          "trigger": "goto",
          "goto": "review",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "review",
      "title": "Üç duraklı rotayı inceleyin",
      "actions": [
        {
          "type": "fill",
          "target": {
            "role": "textbox",
            "name": "Varış noktası seçin veya haritayı tıklayın..."
