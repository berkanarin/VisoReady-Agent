          "goto": "add-stop",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "add-stop",
      "title": "Yeni bir durak ekleyin",
      "actions": [
        {
          "type": "fill",
          "target": {
            "role": "textbox",
            "name": "Varış noktası seçin veya haritayı tıklayın..."
