          "value": "Pantheon, Rome"
        },
        {
          "type": "press",
          "target": {
            "role": "textbox",
            "name": "Hedef Pantheon, Rome"
          },
          "key": "Enter"
        }
      ],
      "ready": {
        "role": "button",
        "name": "Hedef ekleyin"
      },
      "assertions": [
        {
          "target": "[role=\"main\"][aria-label=\"Yol tarifi\"]",
          "containsText": "Ayrıntılar"
        }
      ],
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Hedef ekleyin"
          },
          "label": "Bir durak daha ekleyin",
