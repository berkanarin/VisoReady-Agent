          "value": "Trevi Fountain, Rome"
        },
        {
          "type": "press",
          "target": {
            "role": "textbox",
            "name": "Hedef Trevi Fountain, Rome"
          },
          "key": "Enter"
        }
      ],
      "ready": {
        "role": "button",
        "name": "Hedef ekleyin"
      },
      "assertions": [
        {
          "target": "[role=\"main\"][aria-label=\"Yol tarifi\"]",
          "containsText": "Ayrıntılar"
        }
      ],
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Ayrıntılar"
          },
          "label": "Rotanızı inceleyin",
          "text": "Rota, Kolezyum’u, Panteon’u ve Trevi Çeşmesi’ni birleştiriyor. Yürüyüş adımlarını görmek için Ayrıntılar düğmesine tıklayın.",
          "trigger": "goto",
          "goto": "details",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "details",
      "title": "Yola çıkmadan önce kontrol edin",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Ayrıntılar"
          }
        }
      ],
      "ready": {
        "role": "button",
        "name": "Yol tarifini paylaşın"
      },
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Yol tarifini paylaşın"
          },
          "label": "Rotanız hazır",
          "text": "Google Haritalar’da rotayı paylaşmak için Yol tarifini paylaşın düğmesini kullanabilirsiniz. Yola çıkmadan önce güncel rotayı kontrol edin; bu demo canlı navigasyon değildir.",
          "trigger": "auto",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true
        }
      ],
      "settleMs": 3500
