{
  "version": 1,
  "title": "Google Haritalar’da üç duraklı yürüyüş rotası oluşturun",
  "language": "tr",
  "fidelity": "actual-source",
  "startUrl": "https://www.google.com/maps/search/Colosseum,+Rome/?hl=tr&gl=tr",
  "allowedOrigins": [
    "https://www.google.com"
  ],
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "key": "start",
      "title": "Kolezyum’u başlangıç yapın",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Yol tarifi"
          }
        }
      ],
      "ready": {
        "role": "button",
        "name": "Başlangıç noktası ile hedefin yerini değiştir"
      },
      "annotations": [
        {
          "target": {
            "role": "button",
            "name": "Başlangıç noktası ile hedefin yerini değiştir"
          },
          "label": "Kolezyum’dan başlayın",
          "text": "Kolezyum için Yol tarifi ekranını açtık. Burayı başlangıç noktası yapmak için yer değiştirme düğmesine tıklayın.",
          "trigger": "goto",
          "goto": "walking",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "walking",
      "title": "Yürüyüş yol tarifini seçin",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Başlangıç noktası ile hedefin yerini değiştir"
          }
        }
      ],
      "ready": {
        "role": "radio",
        "name": "Yürüyüş"
      },
      "annotations": [
        {
          "target": {
            "role": "radio",
            "name": "Yürüyüş"
          },
          "label": "Yürüyerek keşfedin",
          "text": "Roma’nın merkezinde yürüyüş rotası oluşturmak için Yürüyüş seçeneğini işaretleyin.",
