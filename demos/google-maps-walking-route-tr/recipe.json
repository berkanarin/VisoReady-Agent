          "goto": "pantheon",
          "style": "frame",
          "spot": "square",
          "backdrop": false,
          "showLabel": true
        }
      ],
      "settleMs": 3500
    },
    {
      "key": "pantheon",
      "title": "İlk varış noktasını belirleyin",
      "actions": [
        {
          "type": "click",
          "target": {
            "role": "radio",
            "name": "Yürüyüş"
          }
        }
      ],
      "ready": {
        "role": "textbox",
        "name": "Varış noktası seçin veya haritayı tıklayın..."
      },
      "annotations": [
        {
          "target": {
            "role": "textbox",
            "name": "Varış noktası seçin veya haritayı tıklayın..."
          },
          "label": "İlk durak: Panteon",
          "text": "Varış alanına Pantheon, Rome yazın ve yeri seçin. İşaretli alana tıklayarak sonucu görebilirsiniz.",
