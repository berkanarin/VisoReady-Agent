{
  "name": "visoready-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Real browser captures to editable VisoReady flows, for coding agents.",
  "type": "module",
  "bin": {
    "visoready-agent": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/*.e2e.ts",
    "agent": "tsx src/cli.ts",
    "setup": "pnpm install --frozen-lockfile && pnpm build && playwright install chromium",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
